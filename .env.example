# Copy this file to .env (git-ignored) and fill in your values. Never commit a real key.
# Both the Streamlit app and the API server (resume_maxxer/api.py) read this file.

# --- Anthropic API key ------------------------------------------------------
# Get one at https://console.anthropic.com/ -> API Keys. It starts with "sk-ant-".
# Leave blank to run without the LLM (bullets are passed through unchanged).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: override the model (default claude-opus-5-5).
RESUME_MAXXER_MODEL=

# Optional: comma-separated origins allowed to call the API (default http://localhost:5173).
RESUME_MAXXER_CORS=
